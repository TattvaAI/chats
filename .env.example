# Public origin; exact HTTPS origin in production, no trailing path.
APP_URL=http://localhost:3000

# Google OAuth: create a Web application client in Google Cloud Console.
# Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Recommended for public launch: users sign in before creating reports.
# Set false only if you intentionally support browser-only guest reports.
REQUIRE_AUTH=true

# Neon: pooled URL for the app; direct URL for migrations. Never NEXT_PUBLIC_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5

# Google Gemini only. Vertex Express is used with your Google Cloud API key.
GEMINI_API=vertex
VERTEX_API_KEY=
# GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY are accepted aliases.
# For an AI Studio key, use GEMINI_API=developer instead.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REPORT_MODEL=gemini-3.8-flash
GEMINI_FOLLOWUP_MODEL=gemini-3.1-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.1-flash-lite

# Jobs and free-use limits. These control request counts, not a dollar budget.
# worker: Railway/other Node host with the separate worker service.
# inline: Next after() + an independently configured recovery scheduler (Vercel).
JOB_EXECUTION_MODE=inline
MAX_ACTIVE_JOBS=3
MAX_CONCURRENT_JOBS=2
MAX_DAILY_REPORTS=50
MAX_REPORTS_PER_ACCOUNT=5
MAX_REPORTS_PER_IP=10
MAX_DAILY_FOLLOWUPS=200
MAX_FOLLOWUPS_PER_ACCOUNT=20
MAX_FOLLOWUPS_PER_IP=50
# Use railway on Railway, vercel on Vercel; none locally.
# cloudflare requires an origin restricted to trusted Cloudflare traffic.
# Never expose the app directly while trusting proxy headers.
TRUSTED_PROXY=none
# At least 32 random characters. Required only for the HTTP recovery cron.
CRON_SECRET=

# Optional. Google login and saved reports work without email delivery.
RESEND_API_KEY=
EMAIL_FROM=
