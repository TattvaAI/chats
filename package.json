{
  "name": "chats",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.cjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "ai:models": "node scripts/gemini-models.mjs",
    "db:migrate": "node scripts/migrate.cjs",
    "release:check": "node scripts/release-check.cjs",
    "worker": "node dist/worker.cjs",
    "worker:dev": "node scripts/worker.cjs",
    "worker:once": "node dist/worker.cjs --once",
    "check": "npm run lint -- --max-warnings=0 && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.85",
    "ai": "^7.0.122",
    "drizzle-orm": "^0.45.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@neon/config": "^1.8.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
